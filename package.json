{
  "name": "conexion-biblica-2026",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:semantic": "node scripts/audit-prep-semantics.mjs",
    "build:v4": "node scripts/build-curated-v4.mjs",
    "audit:v4": "node scripts/audit-curated-v4.mjs",
    "pilot:simulation": "node scripts/pilot-simulation.mjs",
    "test:e2e": "playwright test",
    "audit:gold": "python scripts/audit-gold-bank.py",
    "test:gold": "python -m unittest scripts/test_gold_quality.py",
    "build:final-bank": "python scripts/build-final-bank.py",
    "test:final-bank": "python -m unittest scripts.test_final_editorial",
    "compile:authored": "python scripts/compile-authored-bank.py",
    "test:authored": "python -m unittest scripts.test_authored_question scripts.test_authored_bank_audit",
    "audit:authored": "python scripts/audit-final-bank-deep.py",
    "audit:final:deep": "python scripts/audit-final-bank-deep.py",
    "audit:production": "node scripts/audit-live-final-bank.mjs",
    "audit:competitive": "node scripts/audit-competitive-readiness.mjs",
    "audit:exhaustive": "node scripts/audit-exhaustive-review.mjs",
    "preview": "vite preview",
    "deploy": "vercel --prod --yes"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17",
    "jsdom": "^26.0.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tesseract.js": "^7.0.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^3.2.4"
  }
}
